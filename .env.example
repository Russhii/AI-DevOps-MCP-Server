HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database: SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///./tasks.db
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/devops

# Server Security & API Keys (format: name:key:scopes)
REQUIRE_AUTH=true
API_KEYS=admin:my-secret-123:read+write+destructive

# GitHub Token (Optional, for higher rate limits)
GITHUB_TOKEN=

# MCP Client / Agent Settings
MCP_URL=http://127.0.0.1:8000/mcp
MCP_API_KEY=my-secret-123

# Groq LLM Agent
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
